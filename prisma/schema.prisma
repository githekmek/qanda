generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TEXT
}

enum QuestionStatus {
  PENDING
  ANSWERED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  roomsAsPlayerA    Room[]       @relation("PlayerA")
  roomsAsPlayerB    Room[]       @relation("PlayerB")
  askedQuestions    Question[]   @relation("Asker")
  answeredQuestions Answer[]     @relation("Responder")
  reactions         Reaction[]   @relation("ReactionAuthor")
  createdCodes      AccessCode[] @relation("CodeCreator")
  redeemedCode      AccessCode?  @relation("CodeRedeemer")
}

// Single-use registration code handed out by the admin.
model AccessCode {
  id        String    @id @default(cuid())
  code      String    @unique
  note      String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  redeemedAt DateTime?

  createdById String
  createdBy   User   @relation("CodeCreator", fields: [createdById], references: [id])

  // Set the moment the code is redeemed; unique so a code can never create two accounts.
  redeemedById String? @unique
  redeemedBy   User?   @relation("CodeRedeemer", fields: [redeemedById], references: [id])
}

// A private two-player game. The second seat is claimed through the invite code.
model Room {
  id         String    @id @default(cuid())
  name       String?
  inviteCode String    @unique
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  playerAId String
  playerA   User   @relation("PlayerA", fields: [playerAId], references: [id])

  playerBId String?
  playerB   User?   @relation("PlayerB", fields: [playerBId], references: [id])

  currentAskerId String?

  questions Question[]
}

model Question {
  id          String         @id @default(cuid())
  type        QuestionType
  text        String
  options     String? // JSON-encoded array of up to 5 strings, only for MULTIPLE_CHOICE
  askerAnswer String // asker's own answer: option index as string, or free text
  status      QuestionStatus @default(PENDING)
  createdAt   DateTime       @default(now())

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  askerId String
  asker   User   @relation("Asker", fields: [askerId], references: [id])

  answer    Answer?
  reactions Reaction[]
}

model Answer {
  id        String   @id @default(cuid())
  value     String // responder's answer: option index as string, or free text
  createdAt DateTime @default(now())

  questionId String   @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  responderId String
  responder   User   @relation("Responder", fields: [responderId], references: [id])
}

// Free-text follow-up on a revealed question, so a round can turn into a conversation.
model Reaction {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ReactionAuthor", fields: [authorId], references: [id])
}
