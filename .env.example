# Postgres connection string. For local dev, point this at a local Postgres instance.
# For free production hosting, use a free Postgres from Neon (https://neon.tech) or
# Supabase (https://supabase.com) and paste the connection string here.
DATABASE_URL="postgresql://user:password@localhost:5432/qanda"

# Long random string used to sign session cookies. Generate e.g. with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# One-time code that creates the admin account. Register with it once after
# deploying; afterwards it stops working and all further accounts need an
# access code generated by the admin under /admin.
ADMIN_SETUP_CODE="change-me-to-a-random-code"
